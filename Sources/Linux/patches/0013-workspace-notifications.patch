+    pub fn selectDevSpaceWorkspace(self: *Self, workspace: []const u8) bool {
+        const binding = self.private().devspace_terminal orelse return false;
+        if (binding.exited or !std.mem.eql(u8, binding.workspace, workspace)) return false;
+        binding.client.selectWorkspace(workspace, false) catch return false;
+        return true;
+    }
