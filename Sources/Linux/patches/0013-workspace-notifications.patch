+    pub fn focusDevSpaceWorkspace(self: *Self, workspace: []const u8) bool {
+        const tabs = self.getTabView();
+        for (0..@intCast(tabs.getNPages())) |index| {
+            const page = tabs.getNthPage(@intCast(index));
+            const tab = gobject.ext.cast(Tab, page.getChild()) orelse continue;
+            const tree = tab.getSplitTree().getTree() orelse continue;
+            var it = tree.iterator();
+            while (it.next()) |entry| {
+                if (!entry.view.selectDevSpaceWorkspace(workspace)) continue;
+                tabs.setSelectedPage(page);
+                entry.view.grabFocus();
+                self.as(gtk.Window).present();
+                return true;
+            }
+        }
+        return false;
+    }
+
+    pub fn activateDevSpaceWorkspace(self: *Self, workspace: []const u8) void {
+        if (self.focusDevSpaceWorkspace(workspace)) return;
+        if (self.private().devspace_client) |client| {
+            client.selectWorkspace(workspace, true) catch |err| log.warn("workspace activation failed: {}", .{err});
+        }
+        self.as(gtk.Window).present();
+    }
