+    fn actionSelectWorkspace(
+        _: *gio.SimpleAction,
+        parameter_: ?*glib.Variant,
+        self: *Self,
+    ) callconv(.c) void {
+        const parameter = parameter_ orelse return;
+        const kind = glib.VariantType.new("s");
+        defer kind.free();
+        if (parameter.isOfType(kind) == 0) return;
+        var length: usize = 0;
+        const value = parameter.getString(&length);
+        const workspace = value[0..length];
+        if (workspace.len == 0 or workspace.len > 64) return;
+        var fallback: ?*Window = null;
+        var current: ?*glib.List = self.as(gtk.Application).getWindows();
+        while (current) |node| : (current = node.f_next) {
+            const object: *gobject.Object = @ptrCast(@alignCast(node.f_data orelse continue));
+            const window = gobject.ext.cast(Window, object) orelse continue;
+            if (window.focusDevSpaceWorkspace(workspace)) return;
+            if (fallback == null) fallback = window;
+        }
+        if (fallback == null) {
+            Action.newWindow(self, null, .none) catch return;
+            current = self.as(gtk.Application).getWindows();
+            while (current) |node| : (current = node.f_next) {
+                const object: *gobject.Object = @ptrCast(@alignCast(node.f_data orelse continue));
+                fallback = gobject.ext.cast(Window, object);
+                if (fallback != null) break;
+            }
+        }
+        if (fallback) |window| window.activateDevSpaceWorkspace(workspace);
+    }
