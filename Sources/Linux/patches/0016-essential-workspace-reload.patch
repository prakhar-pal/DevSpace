+    fn actionReloadWorkspace(_: *gio.SimpleAction, _: ?*glib.Variant, self: *Self) callconv(.c) void {
+        const active = self.as(gtk.Application).getActiveWindow();
+        var current: ?*glib.List = self.as(gtk.Application).getWindows();
+        while (current) |node| : (current = node.f_next) {
+            const object: *gobject.Object = @ptrCast(@alignCast(node.f_data orelse continue));
+            const window = gobject.ext.cast(Window, object) orelse continue;
+            if (active) |target| {
+                if (window.as(gtk.Window) != target) continue;
+            }
+            const surface = window.getActiveSurface() orelse return;
+            surface.reloadDevSpaceWorkspace();
+            return;
+        }
     }
 
