+    /// The owner has already decided to stop this shell (e.g. reconnect).
+    /// Reuse the normal removal/focus path without a second user confirmation.
+    pub fn closeSurfaceWithoutConfirmation(self: *Self, surface: *Surface) void {
+        const tree = self.getTree() orelse return;
+        var it = tree.iterator();
+        while (it.next()) |entry| {
+            if (entry.view == surface) {
+                self.private().pending_close = entry.handle;
+                closeConfirmationClose(null, self);
+                return;
+            }
+        }
+    }
