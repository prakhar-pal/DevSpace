+    /// Backend closure is already accounted for by its controller. Only match
+    /// the exact pane generation, and do not echo a stale exit during disposal.
+    pub fn prepareDevSpaceClose(self: *Self, effect: devspace.TerminalEffect) bool {
+        const binding = self.private().devspace_terminal orelse return false;
+        const pane = effect.paneID orelse return false;
+        if (!std.mem.eql(u8, binding.workspace, effect.workspaceID) or
+            !std.mem.eql(u8, binding.generation, effect.generation) or
+            !std.mem.eql(u8, binding.pane, pane)) return false;
+        binding.exited = true;
+        return true;
+    }
