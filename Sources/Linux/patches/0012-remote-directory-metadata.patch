+    pub fn reportRemotePwd(self: *Self, path: []const u8) void {
+        // Only backend-bound SSH panes consume this as editor metadata.
+        // Do not set GTK/terminal pwd: that would trust a remote local path.
+        if (self.private().devspace_terminal) |binding| {
+            binding.report("terminal_directory", path);
+        }
+    }
