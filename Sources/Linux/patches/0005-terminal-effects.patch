+    fn devspaceTerminalEffect(_: *anyopaque, context: ?*anyopaque, effect: devspace.TerminalEffect) !void {
+        const self: *Self = @ptrCast(@alignCast(context.?));
+        if (!std.mem.eql(u8, effect.kind, "terminal_launch")) return;
+        const executable = effect.executable orelse return error.MissingTerminalExecutable;
+        var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+        defer arena.deinit();
+        const alloc = arena.allocator();
+        const argv = try alloc.alloc([:0]const u8, effect.arguments.len + 1);
+        argv[0] = try alloc.dupeZ(u8, executable);
+        for (effect.arguments, 1..) |argument, index| argv[index] = try alloc.dupeZ(u8, argument);
+        // Surface overrides clone argv synchronously. Never concatenate an SSH
+        // command through a shell: paths and proxy arguments stay single args.
+        _ = self.newTabPage(null, .window, .{
+            .command = .{ .direct = argv },
+            .title = try alloc.dupeZ(u8, effect.workspaceID),
+        });
+    }
