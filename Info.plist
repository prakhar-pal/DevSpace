<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Base Info.plist. The Makefile copies this into the assembled .app and then
  overrides per-config keys (CFBundleDisplayName, CFBundleName, CFBundleIconFile,
  and, for Debug, DevSpaceLogPath) via PlistBuddy. CFBundleVersion is also
  overridden on every build (debug and release) to the current git commit
  count — see scripts/assemble-app.sh. The value below is only the fallback
  used when building outside a git checkout.
-->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>DevSpace</string>
    <key>CFBundleIdentifier</key>
    <string>com.prakharp.devspace</string>
    <key>CFBundleName</key>
    <string>DevSpace</string>
    <key>CFBundleDisplayName</key>
    <string>DevSpace</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.5.4</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>DevSpace</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
